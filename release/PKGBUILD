# Maintainer: ECHO Native
pkgname=echo-native
pkgver=0.2.3.1
pkgrel=2
pkgdesc='Graphical Linux launcher for Wuthering Waves Russian localization'
arch=('x86_64')
url='https://github.com/bromhobit/LInux-rusian-WUWA-launcher'
license=('custom')
depends=('glibc>=2.34' 'gcc-libs>=5.1' 'qt6-base>=6.12' 'sdl3>=3.2.0' 'xxhash>=0.8.4')
makedepends=('gcc' 'pkgconf')
source=('echo-native-source-0.2.3.1-2.tar.gz')
sha256sums=('ce3532998d8e72dcd5ad640b2b5f8c681e0cf515df0569265213d660de1e6d8d')

build() {
  cd "$srcdir"
  g++ -std=c++17 $CXXFLAGS -fPIC -Wall -Wextra -Wpedantic \
    -DECHO_SOURCE_DIR='"/usr/share/echo-native"' \
    $(pkg-config --cflags Qt6Widgets Qt6Network sdl3) \
    native/src/main.cpp native/src/auto_install.cpp native/src/controller.cpp \
    $(pkg-config --libs Qt6Widgets Qt6Network sdl3) -lxxhash \
    -o echo-native
}

check() {
  QT_QPA_PLATFORM=offscreen "$srcdir/echo-native" --smoke-test
  QT_QPA_PLATFORM=offscreen "$srcdir/echo-native" --ui-test
  QT_QPA_PLATFORM=offscreen "$srcdir/echo-native" --controller-test
}

package() {
  install -Dm755 "$srcdir/echo-native" "$pkgdir/usr/bin/echo-native"
  install -Dm644 "$srcdir/packaging/echo-native.desktop" "$pkgdir/usr/share/applications/echo-native.desktop"
  install -Dm644 "$srcdir/packaging/echo-native.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/echo-native.svg"
  install -Dm644 "$srcdir/packaging/LICENSE-PACKAGING" "$pkgdir/usr/share/licenses/echo-native/LICENSE"
}
