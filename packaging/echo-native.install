_update_legacy_echo_launcher() {
  getent passwd | while IFS=: read -r user_name password uid gid gecos home_dir login_shell; do
    [ "$uid" != 0 ] || continue
    case "$home_dir" in
      /*) ;;
      *) continue ;;
    esac
    launcher="$home_dir/.local/share/echo-native/bin/echo-native"
    [ -e "$launcher" ] || [ -L "$launcher" ] || continue

    # Pacman runs as root. Only the account owner should modify its launcher.
    if ! runuser -u "$user_name" -- /bin/bash -s -- "$1" "$launcher" <<'BASH'
set -e
operation=$1
launcher=$2
package_launcher=/usr/bin/echo-native
backup="$launcher.pacman-backup"

if [[ $operation == restore ]]; then
  if [[ -L $launcher && $(readlink -- "$launcher") == "$package_launcher" &&
        ! -L $backup && -f $backup && -O $backup && -x $backup ]]; then
    mv -Tf -- "$backup" "$launcher"
  fi
  exit 0
fi

[[ -x $package_launcher && ! -L $launcher && -f $launcher && -O $launcher && -x $launcher ]] || exit 0
stage=$(mktemp -d -- "${launcher%/*}/.pacman-migration.XXXXXX")
trap 'rm -f -- "$stage/echo-native"; rmdir -- "$stage"' EXIT
ln -s -- "$package_launcher" "$stage/echo-native"

# Keep an existing backup only if it is the same file from an interrupted migration.
if [[ -L $backup || ! $launcher -ef $backup ]]; then
  ln -T -- "$launcher" "$backup"
fi
mv -Tf -- "$stage/echo-native" "$launcher"
BASH
    then
      printf 'echo-native: could not %s the legacy launcher for %s\n' "$1" "$user_name" >&2
    fi
  done
}

_refresh_echo_desktop() {
  rm -f /root/.local/share/applications/echo-native.desktop 2>/dev/null || true
  if [ -f /root/.config/menus/applications-kmenuedit.menu ]; then
    sed -i '/<Filename>echo-native\.desktop<\/Filename>/d' /root/.config/menus/applications-kmenuedit.menu 2>/dev/null || true
  fi

  for home_dir in /home/*; do
    [ -d "$home_dir" ] || continue
    rm -f "$home_dir/.local/share/applications/echo-native.desktop" 2>/dev/null || true
    menu_file="$home_dir/.config/menus/applications-kmenuedit.menu"
    user_name="${home_dir##*/}"
    if [ -f "$menu_file" ]; then
      if id "$user_name" >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
        runuser -u "$user_name" -- sed -i '/<Filename>echo-native\.desktop<\/Filename>/d' "$menu_file" 2>/dev/null || true
      else
        sed -i '/<Filename>echo-native\.desktop<\/Filename>/d' "$menu_file" 2>/dev/null || true
        if id "$user_name" >/dev/null 2>&1; then
          chown "$user_name:$user_name" "$menu_file" 2>/dev/null || true
        fi
      fi
    fi
  done

  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  fi

  for home_dir in /home/*; do
    [ -d "$home_dir" ] || continue
    user_name="${home_dir##*/}"
    id "$user_name" >/dev/null 2>&1 || continue
    if command -v runuser >/dev/null 2>&1; then
      if command -v kbuildsycoca6 >/dev/null 2>&1; then
        runuser -u "$user_name" -- env HOME="$home_dir" kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
      elif command -v kbuildsycoca5 >/dev/null 2>&1; then
        runuser -u "$user_name" -- env HOME="$home_dir" kbuildsycoca5 --noincremental >/dev/null 2>&1 || true
      fi
    fi
  done
}

post_install() {
  _update_legacy_echo_launcher migrate
  _refresh_echo_desktop
}

post_upgrade() {
  post_install
}

post_remove() {
  _update_legacy_echo_launcher restore
  _refresh_echo_desktop
}
