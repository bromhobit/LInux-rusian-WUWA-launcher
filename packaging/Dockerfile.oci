FROM scratch
ARG PACKAGE_FILE
ARG VERSION
LABEL org.opencontainers.image.title="ECHO Native"
LABEL org.opencontainers.image.description="Лаунчер Wuthering Waves для установки и управления русской текстовой локализацией на Linux."
LABEL org.opencontainers.image.source="https://github.com/bromhobit/LInux-rusian-WUWA-launcher"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.vendor="ECHO Native"
COPY release/${PACKAGE_FILE} /dist/
COPY release/SHA256SUMS /dist/SHA256SUMS
